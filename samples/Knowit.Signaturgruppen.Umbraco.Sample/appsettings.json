{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "7e623474-9c70-47ff-96a5-abd31f201900",
        "SanitizeTinyMce": true
      },
      "Hosting": {
        "Debug": true
      },
      "Unattended": {
        "InstallUnattended": false
      }
    }
  },
  "Signaturgruppen": {
    "Environment": "Preproduction",
    "ClientId": "THE_CLIENT_ID",
    "ClientSecret": "THE_CLIENT_SECRET",
    "CallbackPath": "/sg/login/callback",
    "SignedOutCallbackPath": "/sg/logout/callback",
    "Scopes": [
      "openid",
      "mitid"
    ],
    "MitId": {
      "LevelOfAssurance": "Substantial",
      "EnableAppSwitch": true
    },
    "AutoLink": {
      "Enabled": true,
      "MemberType": "Member",
      "IsApproved": true
    },
    "ClaimToMemberProperty": {
      "akait.medlemsnummer": "medlemsnummer",
      "mitid.identity_name": "mitidIdentityName"
    }
  },
  "Akait": {
    "BaseUrl": "https://apiprodtest.mycompany.dk/",
    "TokenUrl": "AKAIT_TOKEN_URL",
    "ClientId": "AKAIT_CLIENT_ID",
    "ClientSecret": "AKAIT_CLIENT_SECRET",
    "Scope": "",
    "MedlemsnummerClaimType": "akait.medlemsnummer"
  }
}
